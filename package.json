{
  "name": "mobile-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:install": "npm install @capacitor/core @capacitor/cli @capacitor/android",
    "cap:init": "npx cap init \"GigaHub\" \"site.gigahub.app\" --web-dir dist",
    "cap:add-android": "npm run build && npx cap add android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^5.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/cli": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.0"
  }
}
